# Gemini API configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Explicit opt-in only. When false/absent the backend calls live Gemini and
# requires GEMINI_API_KEY; without the key /analyze returns an honest 502
# instead of a silent mock. Use true for hermetic tests and offline demos.
MOCK_ANALYSIS=true

# Server configuration
HOST=0.0.0.0
PORT=8000
